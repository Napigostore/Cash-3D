rules_version = '2';

// Cash to Freedom: Firestore security rules (Firebase project cash-to-freedom).
// Publish with: firebase deploy --only firestore:rules   (or paste into Firebase console → Firestore → Rules).
// Every player signs in first (Apple, Google or email); guests cannot read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profile: only its owner writes it. Any signed-in player may read a profile (friends list, invite by email).
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(
          ['name', 'email', 'photo', 'lastSeen', 'friends', 'char', 'zod', 'col', 'created', 'updated']);
      allow delete: if isMe(uid);

      // Game invites: anyone signed in may send one, stamped with their own uid; only the receiver reads or deletes it.
      match /invites/{inviteId} {
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
            && request.resource.data.room is string && request.resource.data.room.size() < 200;
        allow read, delete: if isMe(uid);
      }
    }

    // Online rooms. The host's device keeps the game state; members are the only ones who may change it.
    match /rooms/{roomId} {
      allow read: if signedIn();

      // Create: you become the host and the only member, and the room starts open.
      allow create: if signedIn() && request.resource.data.host == request.auth.uid
          && request.auth.uid in request.resource.data.members
          && request.resource.data.status == 'open';

      // Join: an open room, adding yourself. Members update the room (state, seats, view, leave).
      // Host can't be changed, and state and view are size-limited.
      allow update: if signedIn()
          && request.resource.data.host == resource.data.host
          && (
               (resource.data.status == 'open' && request.auth.uid in request.resource.data.members
                  && !(request.auth.uid in resource.data.members))
            || request.auth.uid in resource.data.members
          )
          && (!('state' in request.resource.data) || request.resource.data.state.size() < 1500000)
          && (!('view' in request.resource.data) || request.resource.data.view.size() < 40000);

      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
